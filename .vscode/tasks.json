{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake Build & Run",
            "type": "shell",
            "command": "cmake --build ${workspaceFolder}/build -j4 && ${workspaceFolder}/build/drone_race",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "runOptions": {
                "instancePolicy": "terminateOldest",
                "instanceLimit": 1,
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true,
                "close": false
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}
